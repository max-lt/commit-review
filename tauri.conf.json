{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "commit-review",
  "version": "0.1.0",
  "identifier": "dev.max.commitreview",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Commit review",
        "width": 620,
        "height": 680,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "focus": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
